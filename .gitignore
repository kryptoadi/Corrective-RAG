```gitignore
# API keys and environment variables
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Python environments and cache
venv/
.venv/
__pycache__/
*.py[cod]

# Uploaded PDFs and local data
*.pdf
chroma_data/
temporary.pdf

# Jupyter checkpoints
.ipynb_checkpoints/

# Editor files
.vscode/
```